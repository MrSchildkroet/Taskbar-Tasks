{
  "name": "taskbar-tasks",
  "version": "0.1.0",
  "private": true,
  "main": "app/dist/main.js",
  "workspaces": [
    "app",
    "renderer"
  ],
  "scripts": {
    "dev:main": "tsc -p app --watch",
    "dev:renderer": "vite renderer",
    "dev": "concurrently \"npm:dev:main\" \"npm:dev:renderer\" \"npm:start\"",
    "start": "electron .",
    "build:main": "tsc -p app",
    "build:renderer": "vite build renderer",
    "build": "npm run build:main && npm run build:renderer",
    "postinstall": "electron-rebuild"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0"
  }
}
